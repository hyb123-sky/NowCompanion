root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
dotnet_analyzer_diagnostics_default_severity = warning
dotnet_diagnostic.CA1014.severity = none

[*.{ts,tsx,js,json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
